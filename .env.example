MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio
PORT=3000

# Origens permitidas no CORS, separadas por vírgula
ALLOWED_ORIGINS=https://sabrinacardoso.com

# --- Autenticação (JWT) ---
# Username do admin que pode fazer login
ADMIN_USERNAME=admin
# Hash bcrypt da senha. Gere com: npm run hash-password -- "suaSenha"
ADMIN_PASSWORD_HASH=
# Segredo para assinar os JWT. Gere com: openssl rand -hex 32
JWT_SECRET=
